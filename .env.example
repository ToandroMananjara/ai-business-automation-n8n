# Copier ce fichier en .env, ou lancer scripts/init_env.sh qui génère les secrets.
# Le fichier .env ne doit jamais être commité.

# --- n8n ---------------------------------------------------------------
# Chiffre les credentials stockés par n8n. Ne plus le changer après le premier
# lancement, sinon les credentials existants deviennent illisibles.
N8N_ENCRYPTION_KEY=
N8N_VERSION=latest
TIMEZONE=Europe/Paris

# --- OmniRoute (passerelle LLM) ------------------------------------------
OMNIROUTE_VERSION=latest
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_STORAGE_ENCRYPTION_KEY=
# Mot de passe du dashboard http://localhost:20128 au premier lancement.
OMNIROUTE_INITIAL_PASSWORD=

# --- LLM ---------------------------------------------------------------
# Modèle de référence, à fixer après le test comparatif (CDC § 19.3).
# Un nom de modèle précis, pas un alias de routage automatique.
LLM_MODEL=

# Clé API créée dans le dashboard OmniRoute. Elle est saisie dans un
# credential n8n, pas lue depuis ce fichier par les workflows.
# Gardée ici pour les scripts d'évaluation lancés depuis le terminal.
OMNIROUTE_API_KEY=

# --- Webhooks ----------------------------------------------------------
# Valeur de l'en-tête X-Api-Key attendue par les webhooks n8n (Header Auth).
WEBHOOK_API_KEY=

# --- API n8n -----------------------------------------------------------
# Clé créée dans n8n : Settings > n8n API. Utilisée par les scripts du terminal.
N8N_API_KEY=
