# Copier ce fichier en .env, ou lancer scripts/init_env.sh qui génère les secrets.
# Le fichier .env ne doit jamais être commité.

# --- n8n ---------------------------------------------------------------
# Chiffre les credentials stockés par n8n. Ne plus le changer après le premier
# lancement, sinon les credentials existants deviennent illisibles.
N8N_ENCRYPTION_KEY=
N8N_VERSION=latest
TIMEZONE=Europe/Paris

# --- LLM ---------------------------------------------------------------
# Fournisseur principal : Groq (offre gratuite). Clé sur console.groq.com.
# Fournisseur de secours : Google Gemini (offre gratuite). Clé sur aistudio.google.com.
# Les workflows n'utilisent pas ces clés directement : elles sont saisies dans
# des credentials n8n. Elles sont gardées ici pour les scripts lancés depuis
# le terminal (test des modèles, évaluation).
GROQ_API_KEY=
GEMINI_API_KEY=

# Modèles retenus après le test comparatif (voir eval/model-selection.md).
LLM_PRIMARY_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Webhooks ----------------------------------------------------------
# Valeur de l'en-tête X-Api-Key attendue par les webhooks n8n (Header Auth).
WEBHOOK_API_KEY=

# --- API n8n -----------------------------------------------------------
# Clé créée dans n8n : Settings > n8n API. Utilisée par les scripts du terminal.
N8N_API_KEY=

# --- Google Sheets --------------------------------------------------------
# Identifiant du classeur (dans l'URL, entre /d/ et /edit).
GOOGLE_SHEET_ID=
# Adresse du compte de service à qui le classeur est partagé (rôle Éditeur).
# La clé privée du compte de service n'est jamais ici : elle est saisie dans un
# credential n8n « Google Service Account API ».
GOOGLE_SERVICE_ACCOUNT_EMAIL=
