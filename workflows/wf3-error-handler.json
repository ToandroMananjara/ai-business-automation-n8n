    {
      "parameters": {},
      "id": "c1260f05-4345-5aca-8c73-b5089c138075",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Le node Error Trigger reçoit, pour chaque exécution en échec d'un workflow\n// qui a désigné le WF3 comme « error workflow » :\n// { execution: { id, url, error: { message, description }, lastNodeExecuted, mode }, workflow: { id, name } }\nconst execution = $json.execution || {};\nconst error = execution.error || {};\nconst node = execution.lastNodeExecuted || error.node?.name || '';\nconst message = [error.message, error.description].filter(Boolean).join(' — ') || 'Erreur sans message';\nconst text = `${message} ${node}`.toLowerCase();\n\n// Un type lisible, pour trier le journal et adapter la réaction.\nlet type = 'AUTRE';\nif (/429|rate limit|quota|too many requests/.test(text)) type = 'QUOTA_LLM';\nelse if (/groq|gemini|generativelanguage|classifier|rédiger/.test(text)) type = 'LLM_INDISPONIBLE';\nelse if (/sheets|spreadsheet|googleapis|tickets|faq|écrire le ticket/.test(text)) type = 'GOOGLE_SHEETS';\nelse if (/champ obligatoire|received_at invalide/.test(text)) type = 'REQUETE_INVALIDE';\n\nreturn [{ json: {\n  timestamp: $now.toISO(),\n  workflow: $json.workflow?.name || '',\n  execution_id: execution.id || '',\n  node,\n  error_type: type,\n  error_message: message.slice(0, 500),\n  input_ref: execution.url || '',\n  status: 'OPEN',\n} }];\n"
      },
      "id": "79b5c44d-d882-5dba-8ec1-a78ce73341bf",
      "name": "Formater l'erreur",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        304
      ]
