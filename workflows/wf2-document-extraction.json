    {
      "id": "1d62c954-06bd-5444-ac41-651ceed5fa4d",
      "name": "Évaluer le texte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2040,
        300
      ],
      "parameters": {
        "jsCode": "// Un PDF scanné (une image) ne contient pas de texte : on ne l'envoie pas au LLM.\nconst request = $('Vérifier la requête').first().json;\nconst text = String($json.text || '').trim();\nconst method = $json.method || 'pdf';\nlet problem = '';\nif (request.format === 'autre') problem = `Format non pris en charge (${request.filename}) : à traiter à la main`;\nelse if (text.replace(/\\s/g, '').length < 50) problem = 'Texte illisible ou absent (document scanné ?) : à traiter à la main';\nreturn [{ json: { text, method, readable: !problem, problem } }];\n"
      }
    },
    {
      "id": "c38844e8-d54f-5bf9-a2f3-a57cd4b843db",
