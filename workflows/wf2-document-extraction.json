    {
      "id": "3322f0e3-c58c-59d5-8b2c-7a920b38c3e3",
      "name": "Préparer l'extraction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2500,
        200
      ],
      "parameters": {
        "jsCode": "const request = $('Vérifier la requête').first().json;\nconst prompts = $('Charger les prompts').first().json.prompts;\nconst system = request.document_type === 'cv' ? prompts.extract_cv : prompts.extract_invoice;\nconst base = { temperature: 0, max_completion_tokens: 1500, response_format: { type: 'json_object' },\n  messages: [{ role: 'system', content: system },\n             { role: 'user', content: `Texte du document (${request.filename}) :\\n\\n${$json.text}` }] };\nreturn [{ json: {\n  request: { ...base, model: $env.LLM_PRIMARY_MODEL, reasoning_effort: 'none' },\n  fallback_request: { ...base, model: $env.LLM_FALLBACK_MODEL },\n} }];\n"
      }
    },
