    {
      "id": "1e0f0e52-e9c7-5f16-b055-183b852f1f29",
      "name": "Charger les prompts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// Les deux prompts d'extraction, relus à chaque document.\nconst prompts = {};\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n  prompts[items[i].binary.data.fileName.replace('.md', '')] = buffer.toString('utf8');\n}\nreturn [{ json: { prompts } }];\n"
      }
    },
    {
      "id": "dcc50963-7210-54dd-aa76-a21f14ad7fa9",
      "name": "Vérifier la requête",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// La requête : { document_type: \"cv\" | \"invoice\", filename, content_base64, ticket_id?, test_run? }\nconst body = $('Webhook').first().json.body;\nfor (const field of ['document_type', 'filename', 'content_base64']) {\n  if (!body[field]) throw new Error(`Champ obligatoire manquant dans la requête : ${field}`);\n}\nif (!['cv', 'invoice'].includes(body.document_type)) {\n  throw new Error(`document_type inconnu : ${body.document_type} (attendu : cv ou invoice)`);\n}\nconst extension = body.filename.split('.').pop().toLowerCase();\nconst format = extension === 'pdf' ? 'pdf' : extension === 'docx' ? 'docx' : 'autre';\n// Un .docx est une archive zip, mais le node de décompression ne reconnaît une archive\n// qu'à son extension (zip, gzip, tar) : on présente donc le DOCX comme un .zip.\nconst mime = { pdf: 'application/pdf', docx: 'application/zip' }[format] || 'application/octet-stream';\nconst binaryName = format === 'docx' ? `${body.filename}.zip` : body.filename;\nreturn [{ json: {\n  document_type: body.document_type, filename: body.filename, binary_name: binaryName, format, mime,\n  ticket_id: body.ticket_id || '', test_run: body.test_run || '',\n  content_base64: body.content_base64,\n} }];\n"
      }
    },
