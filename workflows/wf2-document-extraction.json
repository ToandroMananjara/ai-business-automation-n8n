    {
      "id": "3610e3a5-2700-5f7a-8e85-15dfb7ce18f4",
      "name": "Valider et contrôler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3160,
        200
      ],
      "parameters": {
        "jsCode": "// Le LLM recopie ; le code vérifie. Pour un CV : champs et durée d'expérience calculée.\n// Pour une facture : HT + TVA = TTC, échéance après la date de facture, devise ISO.\nconst request = $('Vérifier la requête').first().json;\nconst response = $json;\nconst reasons = [];\nlet data = null;\n\nif (response.error) {\n  const raw = String(response.error.description || response.error.message || '');\n  reasons.push(`LLM indisponible (Groq et Gemini) : ${((raw.match(/\\\\?\"message\\\\?\":\\s*\\\\?\"([^\"\\\\]+)/) || [])[1] || raw).slice(0, 200)}`);\n} else {\n  try {\n    data = JSON.parse((response.choices?.[0]?.message?.content || '').trim().replace(/^```(?:json)?\\s*|\\s*```$/g, ''));\n  } catch (e) {\n    reasons.push(`Réponse du modèle illisible (${e.message})`);\n  }\n}\n\nconst isMonth = v => /^\\d{4}-(0[1-9]|1[0-2])$/.test(v || '');\nconst isDate = v => DateTime.fromISO(String(v || '')).isValid;\nconst isEmail = v => /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(v || '');\nlet computed = {};\n\nif (data && request.document_type === 'cv') {\n  if (!data.name) reasons.push('Nom absent');\n  if (!isEmail(data.email)) reasons.push('Email absent ou invalide');\n  if (!Array.isArray(data.skills)) reasons.push('Compétences mal formées');\n  // Durée d'expérience calculée par le code, en mois inclusifs, à partir des dates extraites.\n  let months = 0;\n  for (const e of Array.isArray(data.experiences) ? data.experiences : []) {\n    if (!isMonth(e.start) || (e.end !== null && !isMonth(e.end))) { reasons.push(`Dates d'expérience illisibles : ${e.title}`); continue; }\n    if (e.end === null) continue;   // poste en cours : non compté, l'agent complétera\n    const [ys, ms] = e.start.split('-').map(Number);\n    const [ye, me] = e.end.split('-').map(Number);\n    const span = (ye - ys) * 12 + (me - ms) + 1;\n    if (span <= 0) reasons.push(`Expérience terminée avant d'avoir commencé : ${e.title}`);\n    else months += span;\n  }\n  computed = { experience_years: Math.round((months / 12) * 10) / 10 };\n}\n\nif (data && request.document_type === 'invoice') {\n  for (const f of ['supplier', 'invoice_number', 'invoice_date', 'due_date', 'amount_excl_tax', 'tax_amount', 'amount_incl_tax', 'currency']) {\n    if (data[f] === null || data[f] === undefined || data[f] === '') reasons.push(`Champ absent : ${f}`);\n  }\n  const [ht, tva, ttc] = [data.amount_excl_tax, data.tax_amount, data.amount_incl_tax].map(Number);\n  if ([ht, tva, ttc].every(Number.isFinite) && Math.abs(ht + tva - ttc) > 0.01) {\n    reasons.push(`Total incohérent : HT + TVA = ${(ht + tva).toFixed(2)}, TTC indiqué = ${ttc.toFixed(2)}`);\n  }\n  if (isDate(data.invoice_date) && isDate(data.due_date) && data.due_date < data.invoice_date) {\n    reasons.push(`Échéance (${data.due_date}) antérieure à la date de facture (${data.invoice_date})`);\n  }\n  if (data.currency && !/^[A-Z]{3}$/.test(data.currency)) reasons.push(`Devise non ISO : ${data.currency}`);\n}\n\nreturn [{ json: { data, computed, reasons, model: response.model || '' } }];\n"
      }
    },
    {
      "id": "89ffafd7-2f33-5578-8787-b22fc76091db",
      "name": "Composer la ligne",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3400,
        300
      ],
      "parameters": {
        "jsCode": "// Assemble la ligne de l'onglet cv ou invoices, quel que soit le chemin suivi.\nconst request = $('Vérifier la requête').first().json;\nconst textCheck = $('Évaluer le texte').first().json;\nconst checked = $('Valider et contrôler').isExecuted ? $('Valider et contrôler').first().json : null;\nconst reasons = checked ? checked.reasons : [textCheck.problem];\nconst d = (checked && checked.data) || {};\nconst base = {\n  processed_at: $now.toISO(), filename: request.filename, format: textCheck.method,\n  status: reasons.length ? 'NEEDS_MANUAL_REVIEW' : 'PENDING_REVIEW',\n  review_reason: reasons.join(' ; '), model: checked ? checked.model : '',\n  execution_id: $execution.id, test_run: request.test_run,\n};\nif (request.document_type === 'cv') {\n  return [{ json: { ...base, ticket_id: request.ticket_id, name: d.name ?? '', email: d.email ?? '', phone: d.phone ?? '',\n    skills: (d.skills || []).join(', '), experience_years: checked ? checked.computed.experience_years ?? '' : '',\n    education: d.education ?? '', document_type: 'cv' } }];\n}\nreturn [{ json: { ...base, supplier: d.supplier ?? '', invoice_number: d.invoice_number ?? '',\n  invoice_date: d.invoice_date ?? '', due_date: d.due_date ?? '', amount_excl_tax: d.amount_excl_tax ?? '',\n  tax_amount: d.tax_amount ?? '', amount_incl_tax: d.amount_incl_tax ?? '', currency: d.currency ?? '',\n  document_type: 'invoice' } }];\n"
      }
    },
