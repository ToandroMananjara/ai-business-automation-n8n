    {
      "id": "6435fee3-7144-58b5-961e-663477c067ef",
      "name": "Lire le texte Word",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        360
      ],
      "parameters": {
        "jsCode": "// Un .docx est une archive zip : le texte est dans word/document.xml.\n// On remplace les fins de paragraphe (</w:p>) par des retours à la ligne, puis on retire les balises.\nconst item = $input.first();\nconst key = Object.keys(item.binary || {}).find(k => item.binary[k].fileName === 'document.xml');\nif (!key) return [{ json: { text: '', method: 'docx (document.xml introuvable)' } }];\nconst xml = (await this.helpers.getBinaryDataBuffer(0, key)).toString('utf8');\nconst text = xml\n  .replace(/<\\/w:p>/g, '\\n')\n  .replace(/<w:tab\\/>/g, '\\t')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&apos;/g, \"'\")\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\nreturn [{ json: { text, method: 'docx' } }];\n"
      }
    },
    {
      "id": "3f2fe958-22ed-56c7-b2da-c115165fd8f4",
      "name": "Format non pris en charge",
