      "id": "n01",
      "name": "Lancer la mise en place",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "n02",
      "name": "Lire config/sheets.json",
