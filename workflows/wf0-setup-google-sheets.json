      "typeVersion": 1.1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "/data/config/sheets.json",
        "options": {}
      }
    },
    {
      "id": "n03",
      "name": "Décoder le JSON",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        440,
        300
      ],
      "parameters": {
        "operation": "fromJson",
        "options": {}
      }
    },
    {
      "id": "n04",
      "name": "Un item par onglet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Transforme la liste des onglets en un item par onglet,\n// pour que la boucle les traite un par un.\nreturn $input.first().json.data.tabs.map(tab => ({ json: tab }));"
      }
    },
    {
      "id": "n05",
      "name": "Pour chaque onglet",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        300
      ],
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "n06",
      "name": "Créer l'onglet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "alwaysOutputData": true,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "sheet",
        "operation": "create",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEET_ID }}"
        },
        "title": "={{ $json.title }}",
        "options": {}
      },
      "credentials": {
        "googleApi": {
          "id": "fshU5mVmgpYUmMeV",
          "name": "Google Service Account account"
        }
      }
    },
    {
      "id": "n07",
      "name": "Ligne d'en-têtes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        400
      ],
      "parameters": {
        "jsCode": "// Un item dont les champs sont les colonnes de l'onglet, avec des valeurs vides.\n// Sur un onglet vide, le node Google Sheets écrit ces noms de champs en ligne 1.\nconst tab = $('Pour chaque onglet').first().json;\nreturn [{ json: Object.fromEntries(tab.columns.map(column => [column, ''])) }];"
      }
    },
    {
      "id": "n08",
      "name": "Écrire les en-têtes",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1560,
        400
      ],
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Pour chaque onglet').first().json.title }}"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleApi": {
          "id": "fshU5mVmgpYUmMeV",
          "name": "Google Service Account account"
        }
      }
    },
    {
      "id": "n09",
      "name": "Lire data/faq.csv",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "executeOnce": true,
      "position": [
        1120,
        120
      ],
      "parameters": {
